@startuml diagrama-panorama-cuantitativo
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam rectangle {
    RoundCorner 10
    BorderColor #555555
    FontSize 13
}
top to bottom direction

title <b>Panorama cuantitativo de la interoperabilidad en el sistema de salud peruano</b>

rectangle "<b>1) Adopción tecnológica</b>\n\n• 74% de IPRESS sin sistema adecuado para HCE\n• Solo 26% usa algún sistema digital\n• 39% aún se basa en registros en papel\n• Madurez en interoperabilidad < 10%" as AT #E8EAF6

rectangle "<b>2) Brecha territorial</b>\n\n• < 40% de adopción de HCE en Lima\n• < 4% de adopción de HCE fuera de Lima" as BT #FFF3E0

rectangle "<b>3) Percepción de usuarios</b>\n\n• 81.48% opina que una HCE única mejoraría la atención\n• 83.33% expresa insatisfacción con el manejo de información" as PU #E8F5E9

rectangle "<b>4) Impacto económico</b>\n\n• Ahorro potencial de hasta 80% en costos\n  por repetición de pruebas (Bayona, 2019)" as IE #FCE4EC

AT -down-> BT : "dimensión territorial"
BT -down-> PU : "experiencia de usuarios"
PU -down-> IE : "consecuencia económica"

@enduml
